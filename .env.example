GEMINI_API_KEY= # API key from https://aistudio.google.com/api-keys
CHAT_MODEL=gemini-2.5-flash # Model code from https://aistudio.google.com/docs/models
SLIDING_WINDOW_SIZE=500 # Token budget before history summarization triggers
DATABASE_URL=postgresql+psycopg://<username>:<password>@localhost:5432/multi_memory # Replace the credentials and database name with your actual PostgreSQL details.
EMBEDDING_DIMENSION=1536
# EMBEDDING_MODEL=gemini-embedding-001 # Reserved for upcoming semantic memory
