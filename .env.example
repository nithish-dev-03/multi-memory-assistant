GEMINI_API_KEY= # API key from https://aistudio.google.com/api-keys
CHAT_MODEL=gemini-2.5-flash # Model code from https://aistudio.google.com/docs/models
EMBEDDING_MODEL=gemini-embedding-001 # Gemini embedding model
EMBEDDING_DIMENSION=1536 # Fixed schema contract (must match pgvector migration)
DATABASE_URL=postgresql+psycopg://<username>:<password>@localhost:5432/multi_memory # Replace with your PostgreSQL details
CLI_USER_ID= # Local development user ID for CLI sessions (e.g., dev-user-001)
CLI_SESSION_ID=cli-session # Default CLI session identifier
SLIDING_WINDOW_SIZE=500 # Token threshold before conversation history summarization triggers
MAX_PROMPT_TOKENS=4000 # Total prompt token ceiling (input + reserved output)
RESPONSE_RESERVE_TOKENS=1000 # Tokens reserved for assistant response
MEMORY_CONTEXT_MAX_TOKENS=1000 # Max tokens allocated to injected long-term memories
SEMANTIC_RETRIEVAL_LIMIT=5 # Max semantic memories retrieved per turn
EPISODIC_RETRIEVAL_LIMIT=5 # Max episodic memories retrieved per turn
# SEMANTIC_MAX_DISTANCE=0.8 # Optional cosine distance threshold (0.0 to 2.0)
